#!/usr/bin/env bash
# yt — terminal YouTube client: fzf UI · yt-dlp metadata · mpv playback
# https://github.com/e12jassir/Youtube-CLI  (MIT)

VERSION="0.1.0"

die() { printf 'yt: %s\n' "$*" >&2; exit 1; }

if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    printf 'yt: bash >= 4 required / se requiere bash >= 4 (macOS: brew install bash)\n' >&2
    exit 1
fi

SELF="${BASH_SOURCE[0]}"
case $SELF in /*) ;; *) SELF="$PWD/$SELF" ;; esac
BIN_DIR="${SELF%/*}"
ROOT_DIR="${BIN_DIR%/*}"
LIB_DIR=""
for d in "$ROOT_DIR/lib/yt" "$ROOT_DIR/lib" "$BIN_DIR/../lib/yt" "$BIN_DIR/../lib" "$BIN_DIR"; do
    if [ -f "$d/core.sh" ]; then
        LIB_DIR="$d"
        break
    fi
done
[ -n "$LIB_DIR" ] || die "library files (core.sh, ui.sh, ...) not found"

OS="$(uname -s)"
TAB=$'\t'

# Source modular libraries
# shellcheck source=../lib/core.sh
source "$LIB_DIR/core.sh"
# shellcheck source=../lib/config.sh
source "$LIB_DIR/config.sh"
# shellcheck source=../lib/cookies.sh
source "$LIB_DIR/cookies.sh"
# shellcheck source=../lib/feeds.sh
source "$LIB_DIR/feeds.sh"
# shellcheck source=../lib/ipc.sh
source "$LIB_DIR/ipc.sh"
# shellcheck source=../lib/player.sh
source "$LIB_DIR/player.sh"
# shellcheck source=../lib/download.sh
source "$LIB_DIR/download.sh"
# shellcheck source=../lib/ui.sh
source "$LIB_DIR/ui.sh"

# ───────────────────────────── paths & init ────────────────────────────────

init() { # mode: full | light
    CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/yt_terminal"
    STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/yt"
    CONFIG_FILE="${YT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/yt/config}"
    THUMB_DIR="$CACHE_DIR/thumbs"
    COOKIE_JAR="$CACHE_DIR/cookies.txt"
    COOKIE_NONE="$CACHE_DIR/cookies.none"
    HISTORY_FILE="$STATE_DIR/history.tsv"
    WATCHLATER_FILE="$STATE_DIR/watchlater.tsv"

    load_config
    set_defaults
    resolve_lang

    mkdir -p "$CACHE_DIR" "$THUMB_DIR" "$STATE_DIR"
    chmod 700 "$CACHE_DIR" "$STATE_DIR" 2>/dev/null || true
    [ -f "$HISTORY_FILE" ]    || : > "$HISTORY_FILE"
    [ -f "$WATCHLATER_FILE" ] || : > "$WATCHLATER_FILE"

    FMT="$(find_helper yt-fmt)"
    PREVIEW="$(find_helper yt-thumb-preview)"

    OWN_RUNDIR=0
    if [ -z "${YT_RUNDIR:-}" ] || [ ! -d "$YT_RUNDIR" ]; then
        YT_RUNDIR="$(mktemp -d "${TMPDIR:-/tmp}/yt.XXXXXX")" || die "cannot create temp dir"
        chmod 700 "$YT_RUNDIR" 2>/dev/null || true
        OWN_RUNDIR=1
    fi
    export YT_RUNDIR YT_CACHE_DIR="$CACHE_DIR" YT_PREVIEW YT_THUMB_QUALITY YT_LANG

    YT_SOCK="$YT_RUNDIR/mpv.sock"
    export YT_SOCK

    migrate_watchlater
    [ "${1:-full}" = full ] && housekeeping
    return 0
}

migrate_watchlater() {
    [ -s "$WATCHLATER_FILE" ] || return 0
    grep -q $'\033' "$WATCHLATER_FILE" 2>/dev/null || return 0
    local tmp="$WATCHLATER_FILE.tmp.$$"
    awk -F'\t' -v OFS='\t' '
        index($1, sprintf("%c", 27)) && NF >= 6 { print $5, $2, $3, $4, $6, "NA", "NA", 0; next }
        { print }' "$WATCHLATER_FILE" > "$tmp" && mv -f "$tmp" "$WATCHLATER_FILE" || rm -f "$tmp"
}

housekeeping() {
    local mark="$CACHE_DIR/.gc"
    is_fresh "$mark" 86400 && return 0
    : > "$mark"
    (
        find "$THUMB_DIR" -type f -mtime +14 -delete 2>/dev/null
        find "$CACHE_DIR" -maxdepth 1 -type f \( -name 'search_*.tsv' -mtime +1 -o -name 'ck.*' -mmin +120 \) -delete 2>/dev/null
        if [ -f "$HISTORY_FILE" ] && [ "$(wc -l < "$HISTORY_FILE")" -gt 3000 ]; then
            tail -n 2000 "$HISTORY_FILE" > "$HISTORY_FILE.tmp.$$" && mv -f "$HISTORY_FILE.tmp.$$" "$HISTORY_FILE"
        fi
    ) </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
}

cleanup() {
    [ -n "${COOKIE_TEMP:-}" ] && rm -f "$COOKIE_TEMP"
    [ "${OWN_RUNDIR:-0}" = 1 ] && [ -n "${YT_RUNDIR:-}" ] && rm -rf "$YT_RUNDIR"
    [ "${YT_INTERACTIVE:-0}" = 1 ] && kitty_clear
    return 0
}

do_action() {
    local act=${1:-}; shift
    case $act in
        play)     valid_id "${2:-}" && play_video "$@" ;;
        mix)      valid_id "${1:-}" && play_mix "$@" ;;
        enqueue)  valid_id "${1:-}" && enqueue_video "$@" ;;
        transport) cmd_transport "$@" ;;
        copy)     valid_id "${1:-}" && { copy_text "https://youtu.be/$1"; notify "📋 youtu.be/$1"; } ;;
        later)    toggle_later "$@" ;;
        download) valid_id "${1:-}" && download_video "$@" ;;
        open)     valid_id "${1:-}" && open_url "$(canonical_url "$1" "${2:--}")" ;;
    esac
    return 0
}

_transport_require_running() {
    mpv_is_running && return 0
    printf 'yt: mpv is not running\n' >&2
    return 1
}

cmd_transport() { # toggle-pause | pause | play | next | prev | seek <s> | status | stop
    local act=${1:-} arg=${2:-}
    case $act in
        status)
            _transport_require_running || return 1
            mpv_get_status
            ;;
        seek)
            [ -n "$arg" ] || { printf 'yt: --seek requires a value (e.g. +10 or -10)\n' >&2; return 2; }
            _transport_require_running || return 1
            mpv_send seek "$arg" >/dev/null 2>&1
            ;;
        stop)
            _transport_require_running || return 1
            mpv_send stop >/dev/null 2>&1
            ;;
        toggle-pause)
            _transport_require_running || return 1
            mpv_send cycle pause >/dev/null 2>&1
            ;;
        pause)
            _transport_require_running || return 1
            mpv_send set_property pause yes >/dev/null 2>&1
            ;;
        play)
            _transport_require_running || return 1
            mpv_send set_property pause no >/dev/null 2>&1
            ;;
        next)
            _transport_require_running || return 1
            mpv_send playlist-next >/dev/null 2>&1
            ;;
        prev)
            _transport_require_running || return 1
            mpv_send playlist-prev >/dev/null 2>&1
            ;;
        *)
            printf 'yt: unknown transport command: %s\n' "$act" >&2
            return 2
            ;;
    esac
}

require_deps() {
    local m=""
    have fzf || m="$m fzf"; have "$YTDLP" || m="$m $YTDLP"; have mpv || m="$m mpv"
    have "$PYTHON" || m="$m $PYTHON"
    [ -n "$m" ] && die "missing:$m — run: yt --doctor"
    local v; v=$(fzf_version)
    version_ge "$v" 0.44.0 || die "fzf $v is too old (need >= 0.44) — run: yt --doctor"
    [ -n "$FMT" ] && [ -n "$PREVIEW" ] || die "helper scripts not found (yt-fmt / yt-thumb-preview) — reinstall: make install"
}

# ───────────────────────────── doctor & maintenance ────────────────────────

ytdlp_age_days() {
    "$PYTHON" - "$1" <<'PY' 2>/dev/null
import datetime, sys
try:
    y, m, d = (int(x) for x in sys.argv[1].split(".")[:3])
    print((datetime.date.today() - datetime.date(y, m, d)).days)
except Exception:
    pass
PY
}

doctor() {
    local fail=0 warn=0 v age js="" r
    row() { printf '  %s %-13s %s\n' "$1" "$2" "$3"; }
    printf 'yt %s — doctor\n\n' "$VERSION"
    row ✓ bash "${BASH_VERSION%%(*}"

    if have fzf; then
        v=$(fzf_version)
        if version_ge "$v" 0.44.0; then row ✓ fzf "$v"; else row ✗ fzf "$v (need >= 0.44)"; fail=1; fi
    else row ✗ fzf "missing"; fail=1; fi

    if have "$YTDLP"; then
        v=$("$YTDLP" --version 2>/dev/null | head -n 1)
        age=$(ytdlp_age_days "$v")
        if [ -n "$age" ] && [ "$age" -gt 90 ]; then row '!' yt-dlp "$v ($age days old — update: yt-dlp -U / pipx upgrade yt-dlp)"; warn=1
        else row ✓ yt-dlp "$v"; fi
    else row ✗ yt-dlp "missing"; fail=1; fi

    for r in deno node bun qjs quickjs; do have "$r" && js="$js $r"; done
    if [ -n "$js" ]; then row ✓ "js runtime" "${js# }"
    else row '!' "js runtime" "none found — YouTube needs one since yt-dlp 2025.11 (install deno: https://deno.com)"; warn=1; fi

    have mpv && row ✓ mpv "$(mpv --version 2>/dev/null | head -n 1 | cut -d' ' -f1-2)" || { row ✗ mpv missing; fail=1; }
    have ffmpeg && row ✓ ffmpeg "found" || { row '!' ffmpeg "missing (needed for HD stream muxing & audio extraction)"; warn=1; }
    have curl && row ✓ curl "found" || { row '!' curl "missing (no thumbnails)"; warn=1; }
    have "$PYTHON" && row ✓ python3 "$("$PYTHON" -V 2>&1)" || { row ✗ python3 missing; fail=1; }
    [ -n "$FMT" ] && row ✓ yt-fmt "$FMT" || { row ✗ yt-fmt "not found (make install)"; fail=1; }
    [ -n "$PREVIEW" ] && row ✓ preview "$PREVIEW" || { row ✗ preview "not found (make install)"; fail=1; }

    if is_kitty_term && { have kitten || have kitty; }; then row ✓ images "kitty graphics"
    elif have chafa; then row ✓ images "chafa (text fallback)"
    else row '!' images "install kitty or chafa for thumbnails"; fi

    r=""
    for v in wl-copy xclip xsel pbcopy clip.exe; do have "$v" && r="$v" && break; done
    [ -n "$r" ] && row ✓ clipboard "$r" || row '!' clipboard "none (falls back to OSC 52)"
    if have notify-send || have osascript; then row ✓ notify "ok"; else row '!' notify "none"; fi

    printf '\n  cookies\n'
    if [ "$YT_COOKIES" = off ]; then row - cookies "disabled (YT_COOKIES=off)"
    else
        r=$(browser_specs | tr '\n' ' ')
        row - candidates "${r:-none detected}"
        if [ -s "$COOKIE_JAR" ] && cookie_has_login "$COOKIE_JAR"; then
            row ✓ session "signed in (jar age $(( $(file_age "$COOKIE_JAR") / 60 )) min)"
        else
            row '!' session "no YouTube login found yet (guest mode: search only)"
        fi
    fi
    printf '\n  config   %s\n  cache    %s\n  state    %s\n' "$CONFIG_FILE" "$CACHE_DIR" "$STATE_DIR"
    [ "$fail" -ne 0 ] && return 2
    [ "$warn" -ne 0 ] && return 1
    return 0
}

show_log() {
    local file="$STATE_DIR/yt.log"
    if [ -s "$file" ]; then
        tail -n 50 "$file"
    else
        echo "no log entries yet"
    fi
}

print_url() {
    local id="" direct=0 a
    for a in "$@"; do
        case $a in
            --direct) direct=1 ;;
            *) [ -z "$id" ] && id=$a ;;
        esac
    done
    if ! valid_id "$id"; then
        printf 'yt: invalid video id\n' >&2
        return 2
    fi
    if [ "$direct" = 1 ]; then
        local url
        url=$(ytdlp -g -- "$id" 2>/dev/null | head -n 1)
        if [ -n "$url" ]; then printf '%s\n' "$url"; return 0; fi
    fi
    printf '%s\n' "$(canonical_url "$id")"
    return 0
}

clear_cache() {
    rm -f "$CACHE_DIR"/feed_*.tsv "$CACHE_DIR"/search_*.tsv "$CACHE_DIR"/ck.* "$CACHE_DIR/.gc"
    rm -rf "$THUMB_DIR"; mkdir -p "$THUMB_DIR"
    echo "cache cleared"
}

usage() {
    cat <<EOF
yt $VERSION — terminal YouTube client (fzf · yt-dlp · mpv)

usage:
  yt                    open your home view (for you / history / search)
  yt QUERY...           search YouTube
  yt --view NAME        foryou | music | subs | later | history | search
  yt --settings         interactive settings menu
  yt --doctor           check dependencies, JS runtime and cookie status
  yt --log              show the last 50 lines of the error log
  yt --print-url ID     print the canonical URL for a video id
  yt --print-url ID --direct   resolve the URL through yt-dlp instead
  yt --status           print the mpv playback status as JSON
  yt --toggle-pause     toggle play/pause of the running player
  yt --pause | --play   pause or resume playback
  yt --next | --prev    skip to the next or previous queue item
  yt --seek SECONDS     seek relative (e.g. +10, -10)
  yt --stop             stop playback
  yt --clear-cache      drop feed/search caches and thumbnails
  yt --forget-cookies   discard the cached cookie jar
  yt --version | --help

keys: enter play · alt-m/^x mix · ^p mini · ^f fullscreen · ^a audio · ^w save
      ^y copy · ^d download · ^o browser · ^s search · ^r reload · alt-1..5 tabs
      alt-space pause · alt-q queue · alt-n next · alt-p prev
config: ${XDG_CONFIG_HOME:-~/.config}/yt/config  (see config.example)
EOF
}

main() {
    trap cleanup EXIT
    case "${1:-}" in
        __list)    shift; init light; cmd_list "$@"; return 0 ;;
        __do)      shift; init light; do_action "$@"; return 0 ;;
    esac
    init full
    case "${1:-}" in
        -h|--help)        usage ;;
        -v|--version)     echo "yt $VERSION" ;;
        --settings)       settings_menu ;;
        --doctor)         doctor ;;
        --log)            show_log ;;
        --print-url)      shift; print_url "$@" ;;
        --status)         cmd_transport status ;;
        --toggle-pause)   cmd_transport toggle-pause ;;
        --pause)          cmd_transport pause ;;
        --play)           cmd_transport play ;;
        --next)           cmd_transport next ;;
        --prev)           cmd_transport prev ;;
        --seek)           shift; cmd_transport seek "${1:-}" ;;
        --stop)           cmd_transport stop ;;
        --clear-cache)    clear_cache ;;
        --forget-cookies) forget_cookies ;;
        --view)           shift; browse "${1:-foryou}" ;;
        -s|--search)      shift; browse search "$*" ;;
        --)               shift; browse search "$*" ;;
        -*)               usage >&2; return 2 ;;
        "")               main_menu ;;
        *)                browse search "$*" ;;
    esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
